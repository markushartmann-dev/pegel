# ─── Pegel – Konfiguration ───────────────────────────────────────────────
# Kopieren nach .env und Werte anpassen. Die Datei .env niemals einchecken.

# Öffentliche Basis-URL, unter der die App erreichbar ist (ohne Slash am Ende).
# Muss exakt der Adresse im Browser entsprechen (Cookies, CSRF-Prüfung, Links in E-Mails).
# Weitere erlaubte Adressen (z. B. zusätzlich die LAN-Adresse) kommagetrennt in TRUSTED_ORIGINS.
APP_URL=https://pegel.example.org
TRUSTED_ORIGINS=

# Host-Port für docker compose
APP_PORT=1717

# Geheimer Schlüssel für Sitzungs-Cookies (mind. 32 Zeichen).
# Erzeugen z. B. mit:  openssl rand -base64 48
AUTH_SECRET=

# Datenbank (wird von compose.yaml für den App-Container zusammengesetzt)
POSTGRES_USER=pegel
POSTGRES_PASSWORD=
POSTGRES_DB=pegel

# Nur für lokale Entwicklung ohne Docker:
# DATABASE_URL=postgresql://pegel:pegel@localhost:54329/pegel

# Sichere Cookies (nur über HTTPS). Standard und Empfehlung: true.
# Nur auf "false" setzen, wenn die App bewusst ohne HTTPS im lokalen Netz betrieben wird
# (z. B. APP_URL=http://192.168.1.10:1717). Dann sind PWA-Installation und Push nicht möglich.
COOKIE_SECURE=true

# Sitzungsdauer in Tagen bei "Angemeldet bleiben" (Verlängerung bei Aktivität, gleitend)
SESSION_MAX_AGE_DAYS=30
# Nach wie vielen Stunden eine aktive Sitzung verlängert wird
SESSION_UPDATE_AGE_HOURS=24

# Registrierung offen? (true/false). Der erste registrierte Benutzer wird Administrator.
REGISTRATION_ENABLED=true

# Zeitzone für Container-Logs und Standardwert neuer Benutzer
TZ=Europe/Berlin
DEFAULT_TIMEZONE=Europe/Berlin

# ─── Modellparameter (Schätzung, keine Messwerte) ────────────────────────
# Abbaurate β in Promille pro Stunde
MODEL_BETA_PER_HOUR=0.15
# Angenommene Resorptionsdauer eines Getränks in Minuten (lineare Aufnahme)
MODEL_ABSORPTION_MINUTES=30

# ─── Sparschwein (Euro) ─────────────────────────────────────────────────
SAVINGS_PER_DAY=5
SAVINGS_WEEK_BONUS=10
SAVINGS_MONTH_BONUS=20

# ─── Optional: E-Mail (SMTP) für Verifizierung und Passwort-Reset ────────
# Ohne SMTP-Konfiguration erzeugt ein Administrator Reset-Links im Admin-Bereich.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Pegel <pegel@example.org>"

# ─── Optional: Web Push (VAPID) ───────────────────────────────────────────
# Schlüsselpaar erzeugen:  docker compose run --rm migrate npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
